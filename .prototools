go = "1.26.5"
bun = "1.3.11"
# node is not used to run the app (bun is), but it IS required to execute the
# node-shebang shims in web/node_modules/.bin — including `tsc`. Without it
# pinned here, `task web-typecheck` fails on a machine set up purely from this
# file, which is how a type error can sit unnoticed locally.
node = "26"
